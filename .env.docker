# Docker environment variables for Opplat
# Copy to .env and fill in your values

# PostgreSQL
POSTGRES_DB=opplat_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Admin123*
POSTGRES_PORT=5432

# Keycloak bootstrap
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=opplat
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Auth (OIDC) - Local Keycloak Development
# Keep these aligned with KEYCLOAK_PORT / KEYCLOAK_REALM if you change the defaults above.
AUTH__AUTHORITY=http://keycloak:8180/realms/opplat
AUTH__AUDIENCE=opplat-api
AUTH__CLIENT_ID_CLIENT=opplat-client
AUTH__CLIENT_ID_ADMIN=opplat-admin

# Published service ports
API_PORT=8080
SALES_API_PORT=8083
INVENTORY_API_PORT=8082
FRONTEND_PORT=3100
ADMIN_FRONTEND_PORT=3101

# Frontend Auth Configuration
# Keep these aligned with KEYCLOAK_PORT / KEYCLOAK_REALM if you change the defaults above.
VITE_AUTH_AUTHORITY=http://localhost:8180/realms/opplat
VITE_AUTH_CLIENT_ID=opplat-client
VITE_AUTH_AUDIENCE=opplat-api
VITE_AUTH_SCOPE=openid profile email offline_access

# Admin Frontend Auth Configuration
# Keep these aligned with KEYCLOAK_PORT / KEYCLOAK_REALM if you change the defaults above.
VITE_ADMIN_AUTH_AUTHORITY=http://localhost:8180/realms/opplat
VITE_ADMIN_AUTH_CLIENT_ID=opplat-admin
VITE_ADMIN_AUTH_AUDIENCE=opplat-api
VITE_ADMIN_AUTH_SCOPE=openid profile email offline_access

# API URLs for frontend
VITE_API_URL=http://localhost:8080
VITE_AUTH_API_URL=http://localhost:8080
VITE_SALES_API_URL=http://localhost:8083
VITE_INVENTORY_API_URL=http://localhost:8082
