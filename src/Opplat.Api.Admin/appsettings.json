{
  "ConnectionStrings": {
    "AdminDatabase": "Host=localhost;Port=5432;Database=opplat_admin;Username=postgres;Password=Admin123*"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Provider": "EntraId",
    "Audience": "api://__set-admin-api-app-id-uri__",
    "ValidIssuers": [],
    "ClaimNamespace": "https://opplat.com",
    "AdminRole": "SuperAdmin",
    "TenantAdminRole": "TenantAdmin",
    "TenantUserRole": "TenantUser",
    "AdditionalRoleClaimTypes": [ "roles" ],
    "Entra": {
      "TenantId": "__set-from-entra-portal__",
      "AuthorityHost": "https://login.microsoftonline.com",
      "UseV2Endpoint": true,
      "ObjectIdClaimType": "oid"
    },
    "AdminBff": {
      "ClientId": "__set-admin-bff-app-client-id__",
      "ClientSecret": "__set-admin-bff-client-secret-or-env__",
      "ShellModeEnabled": false,
      "Scopes": [ "openid", "profile", "email", "api://__set-admin-api-app-id__/access_as_user" ],
      "UsePkce": true,
      "GetClaimsFromUserInfoEndpoint": true,
      "UseAudienceQueryParam": false,
      "LoginPath": "/auth/bff/admin/login",
      "LogoutPath": "/auth/bff/admin/logout",
      "CallbackPath": "/signin-oidc-admin",
      "SignedOutCallbackPath": "/signout-callback-oidc-admin",
      "AccessDeniedPath": "/auth/bff/admin/access-denied",
      "SessionCookieName": "opplat.admin.session",
      "CsrfCookieName": "opplat.admin.csrf",
      "CsrfHeaderName": "X-Opplat-CSRF",
      "SessionHours": 8,
      "DefaultOrigin": "http://localhost:3201",
      "AllowedOrigins": [
        "http://localhost:3001",
        "http://localhost:3101",
        "http://localhost:3201",
        "http://localhost:5174"
      ]
    }
  },
  "GraphApi": {
    "Enabled": false,
    "TenantId": "__set-from-entra-portal__",
    "ClientId": "__set-graph-app-client-id__",
    "ClientSecret": "__set-graph-app-client-secret-or-env__",
    "CertificateThumbprint": "",
    "TenantDomain": "yourtenant.onmicrosoft.com",
    "BaseUrl": "https://graph.microsoft.com/",
    "Scope": "https://graph.microsoft.com/.default",
    "MaxRetries": 3,
    "BaseDelaySeconds": 2
  },
  "Documentation": {
    "Version": "v1",
    "Title": "Opplat Admin Service",
    "Description": "Dedicated admin API for admin auth, tenant catalog, and tenant user management."
  },
  "TenantStore": {
    "CatalogPath": "Data\\tenant-catalog.json"
  },
  "TenantDatabase": {
    "Host": "localhost",
    "Port": 5432,
    "Username": "postgres",
    "Password": "Admin123*"
  },
  "DatabaseInstance": {
    "MaxTenantsPerInstance": 50,
    "InitialDatabaseInstanceId": 1
  },
  "AllowedHosts": "*"
}
